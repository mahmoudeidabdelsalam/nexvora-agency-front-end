diff --git a/components/assistant/NexvoraAssistant.tsx b/components/assistant/NexvoraAssistant.tsx
new file mode 100644
index 0000000..63d4664
--- /dev/null
+++ b/components/assistant/NexvoraAssistant.tsx
@@ -0,0 +1,259 @@
+"use client";
+
+/**
+ * Floating chat + voice assistant for a Next.js static export.
+ * Needs: npm i livekit-client   and   NEXT_PUBLIC_VOICE_API_URL=https://<your-worker>.workers.dev
+ * Rendered once from app/layout.tsx. Renders nothing until NEXT_PUBLIC_VOICE_API_URL is set.
+ */
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { Room } from "livekit-client";
+
+const API = process.env.NEXT_PUBLIC_VOICE_API_URL ?? "";
+
+type Lang = "ar-eg" | "en";
+type Status = "idle" | "connecting" | "live" | "error";
+type Msg = { id: string; role: "user" | "assistant"; text: string };
+
+const T = {
+  "ar-eg": {
+    title: "مساعد NEXVORA",
+    placeholder: "اكتب سؤالك عن خدماتنا…",
+    send: "إرسال",
+    mic: "تحدث",
+    micOff: "إيقاف المايك",
+    open: "افتح المساعد",
+    close: "إغلاق",
+    hello: "أهلاً! اسألني عن خدمات NEXVORA، أو اضغط على المايك وتكلم معايا.",
+    err: "حصلت مشكلة في الاتصال. جرّب تاني بعد شوية أو تواصل معانا من صفحة اتصل بنا.",
+    mic_denied: "محتاج إذن المايك عشان نتكلم صوت.",
+    dir: "rtl" as const,
+  },
+  en: {
+    title: "NEXVORA Assistant",
+    placeholder: "Ask about our services…",
+    send: "Send",
+    mic: "Talk",
+    micOff: "Stop mic",
+    open: "Open assistant",
+    close: "Close",
+    hello: "Hi! Ask me about NEXVORA's services, or tap the mic to talk.",
+    err: "Connection problem. Please try again shortly or use our contact page.",
+    mic_denied: "Microphone permission is needed for voice.",
+    dir: "ltr" as const,
+  },
+};
+
+export default function NexvoraAssistant() {
+  const [open, setOpen] = useState(false);
+  const [lang, setLang] = useState<Lang>("ar-eg");
+  const [status, setStatus] = useState<Status>("idle");
+  const [voice, setVoice] = useState(false);
+  const [msgs, setMsgs] = useState<Msg[]>([]);
+  const [input, setInput] = useState("");
+  const [notice, setNotice] = useState("");
+  const roomRef = useRef<Room | null>(null);
+  const modeRef = useRef<"text" | "voice" | null>(null);
+  const audioEls = useRef<HTMLMediaElement[]>([]);
+  const endRef = useRef<HTMLDivElement>(null);
+  const t = T[lang];
+
+  useEffect(() => {
+    endRef.current?.scrollIntoView({ behavior: "smooth" });
+  }, [msgs]);
+
+  const disconnect = useCallback(async () => {
+    audioEls.current.forEach((el) => el.remove());
+    audioEls.current = [];
+    await roomRef.current?.disconnect();
+    roomRef.current = null;
+    modeRef.current = null;
+    setStatus("idle");
+    setVoice(false);
+  }, []);
+
+  useEffect(() => () => void disconnect(), [disconnect]);
+
+  const upsert = (id: string, role: Msg["role"], text: string) =>
+    setMsgs((prev) => {
+      const i = prev.findIndex((m) => m.id === id);
+      if (i === -1) return [...prev, { id, role, text }];
+      const next = [...prev];
+      next[i] = { ...next[i], text };
+      return next;
+    });
+
+  const connect = useCallback(
+    async (mode: "text" | "voice") => {
+      if (roomRef.current && modeRef.current === mode) return roomRef.current;
+      await disconnect();
+      setStatus("connecting");
+      setNotice("");
+      try {
+        const res = await fetch(`${API}/token?lang=${lang}&mode=${mode}`);
+        if (!res.ok) throw new Error(String(res.status));
+        const { url, token } = (await res.json()) as { url: string; token: string };
+
+        const { Room, RoomEvent, Track } = await import("livekit-client");
+        const room = new Room();
+
+        room.on(RoomEvent.TrackSubscribed, (track) => {
+          if (track.kind === Track.Kind.Audio) {
+            const el = track.attach();
+            el.style.display = "none";
+            document.body.appendChild(el);
+            audioEls.current.push(el);
+          }
+        });
+        room.on(RoomEvent.Disconnected, () => {
+          if (roomRef.current === room) {
+            roomRef.current = null;
+            modeRef.current = null;
+            setStatus("idle");
+            setVoice(false);
+          }
+        });
+
+        // Agent replies (and the visitor's own speech transcripts) arrive on this topic.
+        room.registerTextStreamHandler("lk.transcription", async (reader, participant) => {
+          const attrs = reader.info.attributes ?? {};
+          const segId = attrs["lk.segment_id"] ?? reader.info.id;
+          const isMine = participant.identity === room.localParticipant.identity;
+          let text = "";
+          for await (const chunk of reader) {
+            text += chunk;
+            upsert(segId, isMine ? "user" : "assistant", text);
+          }
+        });
+
+        await room.connect(url, token);
+        if (mode === "voice") await room.localParticipant.setMicrophoneEnabled(true);
+        await room.startAudio();
+
+        roomRef.current = room;
+        modeRef.current = mode;
+        setStatus("live");
+        return room;
+      } catch (e) {
+        const denied = e instanceof Error && /permission|denied|notallowed/i.test(e.message);
+        setNotice(denied ? t.mic_denied : t.err);
+        setStatus("error");
+        await disconnect();
+        setStatus("error");
+        return null;
+      }
+    },
+    [disconnect, lang, t.err, t.mic_denied]
+  );
+
+  const sendText = async () => {
+    const text = input.trim();
+    if (!text) return;
+    setInput("");
+    upsert(`u-${Date.now()}`, "user", text);
+    const room = roomRef.current ?? (await connect("text"));
+    if (!room) return;
+    await room.localParticipant.sendText(text, { topic: "lk.chat" });
+  };
+
+  const toggleVoice = async () => {
+    if (voice) {
+      await disconnect();
+      return;
+    }
+    const room = await connect("voice");
+    if (room) setVoice(true);
+  };
+
+  const changeLang = async (l: Lang) => {
+    if (l === lang) return;
+    await disconnect(); // the agent's language is fixed per session
+    setLang(l);
+    setMsgs([]);
+  };
+
+  if (!API) return null;
+
+  return (
+    <div className="fixed bottom-4 end-4 z-50" dir={t.dir}>
+      {!open && (
+        <button
+          onClick={() => setOpen(true)}
+          aria-label={t.open}
+          className="h-14 w-14 rounded-full bg-[var(--primary)] text-white shadow-lg"
+        >
+          💬
+        </button>
+      )}
+
+      {open && (
+        <section
+          role="dialog"
+          aria-label={t.title}
+          className="flex h-[32rem] w-[22rem] max-w-[calc(100vw-2rem)] flex-col overflow-hidden rounded-2xl border bg-white text-black shadow-2xl"
+        >
+          <header className="flex items-center justify-between gap-2 bg-[var(--secondary)] px-4 py-3 text-white">
+            <strong className="text-sm">{t.title}</strong>
+            <div className="flex items-center gap-2">
+              <select
+                value={lang}
+                onChange={(e) => void changeLang(e.target.value as Lang)}
+                className="rounded bg-white/10 px-1 py-0.5 text-xs"
+                aria-label="Language"
+              >
+                <option value="ar-eg" className="text-black">عربي</option>
+                <option value="en" className="text-black">EN</option>
+              </select>
+              <button
+                onClick={() => {
+                  void disconnect();
+                  setOpen(false);
+                }}
+                aria-label={t.close}
+              >
+                ✕
+              </button>
+            </div>
+          </header>
+
+          <div className="flex-1 space-y-2 overflow-y-auto p-3 text-sm" aria-live="polite">
+            <p className="rounded-xl bg-gray-100 p-2">{t.hello}</p>
+            {msgs.map((m) => (
+              <p
+                key={m.id}
+                className={`max-w-[85%] whitespace-pre-wrap rounded-xl p-2 ${
+                  m.role === "user" ? "ms-auto bg-[var(--primary)] text-white" : "bg-gray-100"
+                }`}
+              >
+                {m.text}
+              </p>
+            ))}
+            {status === "connecting" && <p className="text-xs opacity-60">…</p>}
+            {notice && <p className="text-xs text-red-600">{notice}</p>}
+            <div ref={endRef} />
+          </div>
+
+          <div className="flex items-center gap-2 border-t p-2">
+            <button
+              onClick={() => void toggleVoice()}
+              aria-pressed={voice}
+              aria-label={voice ? t.micOff : t.mic}
+              className={`h-10 w-10 shrink-0 rounded-full ${voice ? "bg-red-600 text-white" : "bg-gray-200 text-[var(--secondary)]"}`}
+            >
+              🎤
+            </button>
+            <input
+              value={input}
+              onChange={(e) => setInput(e.target.value)}
+              onKeyDown={(e) => e.key === "Enter" && void sendText()}
+              placeholder={t.placeholder}
+              className="min-w-0 flex-1 rounded-lg border px-3 py-2 text-sm"
+            />
+            <button onClick={() => void sendText()} className="rounded-lg bg-[var(--primary)] px-3 py-2 text-sm text-white">
+              {t.send}
+            </button>
+          </div>
+        </section>
+      )}
+    </div>
+  );
+}
